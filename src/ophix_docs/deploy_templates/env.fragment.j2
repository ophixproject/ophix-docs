# ---------------------------------------------------------------------------
# ophix-docs — Inline markdown documentation plugin
# ---------------------------------------------------------------------------

# Show or hide the Documentation section in the admin navigation entirely.
# When False, all doc pages remain in the database but the admin section is
# suppressed. Useful if you want to keep docs imported but temporarily hide
# them (e.g. during a content review). Does not affect the import commands.
#
# Valid values: True, False
# Default: True
OPHIX_DOCS_ENABLED=True

# Absolute path to the primary docs folder for server-level documentation
# (markdown files not shipped with any specific app). If not set, defaults
# to a docs/ folder in BASE_DIR (next to the project root). This is separate
# from app docs, which are loaded via --include-app-docs on the import command.
#
# Only set this if you have a custom docs directory outside the project root.
#
# Valid values: absolute filesystem path
# Default: BASE_DIR/docs (unset)
# OPHIX_DOCS_PATH=/srv/ophix/docs

# Label shown for the Documentation section in the admin left navigation.
# Override if you want a more specific label, e.g. "Server Manual" or
# "Runbook", to distinguish from documentation on other servers in the fleet.
#
# Valid values: any string
# Default: Documentation (unset)
# OPHIX_DOCS_APP_LABEL=Documentation
